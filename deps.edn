{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj).
 ;;
 ;; This other-livestock vertical is SELF-CONTAINED: there is no
 ;; `kotoba-lang/other-livestock-raising` to delegate facility-registration /
 ;; cost-threshold / closed-op-allowlist checks to, so those pure functions
 ;; live in `otherlivestockops.registry` / `otherlivestockops.facts` rather
 ;; than wrapping an external lib. This repo is standalone (forkable outside
 ;; the workspace); the :local/root paths only resolve inside the monorepo
 ;; checkout -- a standalone fork should override them with git
 ;; coordinates. For testing/CI without langgraph, use the core logic in
 ;; run-operation; production deployment requires the langgraph StateGraph
 ;; integration.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       }
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "otherlivestockops.sim"]}
  ;; clojure -M:render-html [out-file]
  ;;   -> regenerate docs/samples/operator-console.html by driving the REAL
  ;;      actor stack (operation -> advisor -> governor -> phase -> store)
  ;;      at build time and reading back what it returned. Throws rather
  ;;      than writing a page whose claims the run did not produce.
  ;;      The DADS dependency is scoped to THIS alias on purpose: the
  ;;      library itself stays zero-dependency, so `-M:run` / `-M:test`
  ;;      resolve nothing extra.
  :render-html {:extra-deps
                {io.github.kotoba-lang/jp-go-digital-design-system
                 {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
                  :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}}
                :main-opts ["-m" "otherlivestockops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
